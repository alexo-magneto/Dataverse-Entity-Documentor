# Copy to .env (never commit) or export in your shell. Env vars override config.json.
DATAVERSE_URL=https://yourorg.crm.dynamics.com
DATAVERSE_TENANT_ID=
DATAVERSE_CLIENT_ID=
DATAVERSE_CLIENT_SECRET=
# Optional: clientCredentials | clientCertificate | interactive | deviceCode | accessToken
DATAVERSE_AUTH_MODE=
# Optional: a token from `az account get-access-token --resource https://yourorg.crm.dynamics.com --query accessToken -o tsv`
DATAVERSE_ACCESS_TOKEN=
